{
  "name": "albion-craft-lab",
  "version": "1.10.0",
  "description": "Калькулятор крафта и перевозок Albion Online",
  "author": "Albion Lab",
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sashasychev05-sketch/albion-craft-lab.git"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:statistics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-statistics-analysis.ps1",
    "prebuild:win": "npm run build:statistics"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.albioncraftlab.desktop",
    "productName": "Albion Lab",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.cjs",
      "desktop/avalon-ocr.ps1",
      "desktop/assets/icon.ico",
      "package.json",
      "desktop/avalon-python-host.ps1",
      "desktop/avalon-worker.py"
    ],
    "asar": true,
    "asarUnpack": [
      "desktop/avalon-ocr.ps1",
      "desktop/avalon-python-host.ps1",
      "desktop/avalon-worker.py",
      "desktop/session-worker.cjs",
      "desktop/session-database.cjs"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "sashasychev05-sketch",
        "repo": "albion-craft-lab",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/assets/icon.ico",
      "artifactName": "Albion-Lab-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Albion Lab",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ]
    },
    "extraResources": [
      {
        "from": "desktop/vendor/aodp",
        "to": "aodp",
        "filter": [
          "albiondata-client.exe",
          "LICENSE",
          "BUILD.md"
        ]
      },
      {
        "from": "work/sat-publish",
        "to": "statistics-analysis"
      },
      {
        "from": "LICENSE",
        "to": "licenses/GPL-3.0.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "license": "GPL-3.0-only"
}
